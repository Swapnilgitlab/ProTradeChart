{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProTradeChart",
  "version": "0.3.0",
  "identifier": "io.github.swapnilgitlab.protradechart",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ProTradeChart",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost https: wss:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm"],
    "createUpdaterArtifacts": true,
    "publisher": "ProTradeChart contributors",
    "copyright": "Copyright (C) 2026 Swapnil Pawar and the ProTradeChart contributors",
    "category": "Finance",
    "shortDescription": "Open-source desktop charting software",
    "longDescription": "Fast candlestick charts, technical indicators, drawing tools, watchlists and saved layouts. Free and open source.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md",
      "../THIRD_PARTY_LICENSES.txt": "THIRD_PARTY_LICENSES.txt",
      "../LICENSE": "LICENSE"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRDNERkFCRkUzQzVDQkYKUldTL1hEeitxOS9UODVtdURJWC9XVnYwZGtOOU8rUHRiRFlJQ0g3OUQ2RE9jUjB4d01URlFHZzcK",
      "endpoints": ["https://github.com/Swapnilgitlab/ProTradeChart/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
