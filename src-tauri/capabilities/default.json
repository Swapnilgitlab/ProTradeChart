{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and any additional chart windows",
  "windows": ["main", "chart-*"],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-create",
    "opener:default",
    "notification:default",
    "updater:default",
    "dialog:default",
    "log:default"
  ]
}
