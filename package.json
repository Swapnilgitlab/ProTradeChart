{
  "name": "protradechart",
  "private": true,
  "version": "0.2.0",
  "description": "Open-source desktop charting software — fast candlestick charts, indicators, drawing tools, watchlists and saved layouts.",
  "license": "AGPL-3.0-only",
  "author": "Swapnil Pawar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Swapnilgitlab/ProTradeChart.git"
  },
  "homepage": "https://github.com/Swapnilgitlab/ProTradeChart",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:python": "python -m unittest discover -s python/tests",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "licenses": "node scripts/third-party-licenses.mjs",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@luxalgo/vela": "^0.8.0",
    "@luxalgo/vela-pinets": "^0.2.14",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-log": "^2.10.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "lucide-react": "^0.577.0",
    "pinets": "^0.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.11"
  }
}
