          "series": ["EQ"],
          "watchlist": null,
          "symbols": [],
          "max_symbols": null
        },
        "filters": [
          { "left": "rsi_14@W", "op": "between", "right": [40, 60] },
          { "left": "close", "op": ">=", "right": "ema_50@M" },
          { "left": "gap_up", "op": ">", "right": 0.02 },
          { "left": "change_1", "op": "outside", "right": [-5, 5] }
        ],
        "columns": ["close"],
        "sort": { "column": "rsi_14@W", "descending": true },
        "benchmark": null
      }
    }
  ]
}
