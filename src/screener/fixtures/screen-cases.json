{
  "_about": "Screen cases both validators are tested against: src/screener/spec.test.ts (normalizeScreen) and python/tests/test_screen.py (normalize_screen). Each case replaces top-level keys of `base`. A refused case must fail with a message containing `word`; an accepted case must normalise to exactly `expect` in both languages.",
  "base": {
    "version": 1,
    "name": "Near 52-week high",
    "universe": { "source": "instruments", "provider": "zerodha", "exchanges": ["NSE"] },
    "filters": [{ "left": "dist_high_252", "op": ">=", "right": -0.05 }],
    "columns": ["close", "return_1", "volume"],
    "sort": { "column": "return_1", "descending": true }
  },
  "refused": [
    { "patch": { "name": "  " }, "word": "needs a name" },
    { "patch": { "version": 2 }, "word": "version 1 screens" },
    { "patch": { "universe": { "source": "everything" } }, "word": "universe.source" },
    { "patch": { "universe": { "provider": "yahoo" } }, "word": "universe.provider" },
    { "patch": { "universe": { "exchanges": [] } }, "word": "universe.exchanges" },
    { "patch": { "universe": { "series": ["XX"] } }, "word": "universe.series" },
    { "patch": { "universe": { "source": "watchlist" } }, "word": "universe.watchlist" },
    { "patch": { "universe": { "source": "symbols", "symbols": [] } }, "word": "at least one symbol" },
    { "patch": { "universe": { "source": "symbols", "symbols": ["RELIANCE"] } }, "word": "universe.symbols" },
    { "patch": { "universe": { "max_symbols": 0 } }, "word": "universe.max_symbols" },
    { "patch": { "universe": { "max_symbols": 1.5 } }, "word": "universe.max_symbols" },
    { "patch": { "filters": "rsi_14 < 30" }, "word": "filters must be a list" },
    { "patch": { "filters": [{ "left": "rsi_99999", "op": "<", "right": 30 }] }, "word": "filters[0]" },
    { "patch": { "filters": [{ "left": "rsi_14", "op": "==", "right": 30 }] }, "word": "filters[0]" },
    { "patch": { "filters": "TWENTY_ONE_FILTERS" }, "word": "at most 20" },
    { "patch": { "columns": "close" }, "word": "columns must be a list" },
    { "patch": { "columns": ["close", "shiny_3"] }, "word": "unknown feature" },
    { "patch": { "columns": "THIRTY_ONE_COLUMNS" }, "word": "at most 30" },
    { "patch": { "sort": "close" }, "word": "sort must be" },
    { "patch": { "sort": { "column": "rsi_14", "descending": true } }, "word": "sort.column must be one of" },
    { "patch": { "columns": ["rs_126"], "sort": null }, "word": "benchmark" },
    { "patch": { "benchmark": "NIFTY" }, "word": "benchmark must be" },
    { "patch": { "filters": [{ "left": "rsi_14", "op": "between", "right": [60, 40] }] }, "word": "low end" },
    { "patch": { "filters": [{ "left": "rsi_14", "op": "between", "right": 50 }] }, "word": "range" },
    { "patch": { "filters": [{ "left": "rsi_14", "op": ">", "right": [40, 60] }] }, "word": "right side" },
    { "patch": { "filters": [{ "left": "rsi_14@H", "op": ">", "right": 50 }] }, "word": "filters[0]" }
  ],
  "accepted": [
    {
      "about": "defaults are filled in, a filter's feature is sortable, text conditions and aliases are read",
      "patch": {
        "filters": ["relative_volume > 2", { "left": "close", "op": "crosses_above", "right": "EMA_50", "label": "dropped" }],
        "columns": ["close", "return_1d", "close"],
        "sort": { "column": "rvol_20" }
      },
      "expect": {
        "version": 1,
        "name": "Near 52-week high",
        "universe": {
          "source": "instruments",
          "provider": "zerodha",
          "exchanges": ["NSE"],
          "series": ["EQ"],
          "watchlist": null,
          "symbols": [],
          "max_symbols": null
        },
        "filters": [
          { "left": "rvol_20", "op": ">", "right": 2 },
          { "left": "close", "op": "crosses_above", "right": "ema_50" }
        ],
        "columns": ["close", "return_1"],
        "sort": { "column": "rvol_20", "descending": true },
        "benchmark": null
      }
    },
    {
      "about": "a watchlist with no filters and no sort is a plain table; series keep their canonical order; a screen saved with Dhan, no longer a source, reads Zerodha",
      "patch": {
        "name": "  My list  ",
        "universe": { "source": "watchlist", "watchlist": " Swing ", "provider": "dhan", "exchanges": ["BSE", "NSE", "BSE"], "series": ["SME", "EQ"], "max_symbols": 50 },
        "filters": [],
        "columns": ["rs_126"],
        "sort": null,
        "benchmark": "zerodha:NSE:NIFTY 500"
      },
      "expect": {
