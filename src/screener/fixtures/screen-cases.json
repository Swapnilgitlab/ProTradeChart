          "provider": "zerodha",
          "exchanges": ["BSE", "NSE"],
          "series": ["EQ", "SME"],
          "watchlist": "Swing",
          "symbols": [],
          "max_symbols": 50
        },
        "filters": [],
        "columns": ["rs_126"],
        "sort": null,
        "benchmark": "zerodha:NSE:NIFTY 500"
      }
    },
    {
      "about": "weekly and monthly features, the new price features and range conditions",
      "patch": {
        "filters": [
          { "left": "RSI_14@w", "op": "between", "right": [40, 60] },
          { "left": "close", "op": ">=", "right": "ema_50@M" },
          { "left": "gap_up", "op": ">", "right": 0.02 },
