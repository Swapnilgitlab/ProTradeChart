# Dependencies & build output
node_modules
dist
dist-ssr
coverage

# Logs
logs
*.log
npm-debug.log*

# Local env / overrides
.env
.env.*
!.env.example
*.local

# Editors & OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.DS_Store
Thumbs.db
*.suo
*.sw?

# Python (the protrade client's tests, and anything run in the repo)
__pycache__/
*.pyc

# Tauri / Rust (see also src-tauri/.gitignore)
src-tauri/target

# Updater signing keys (the private half must never be committed)
*.key
.tauri/
